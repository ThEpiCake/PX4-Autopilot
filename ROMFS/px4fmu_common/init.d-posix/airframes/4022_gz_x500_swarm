#!/bin/sh
#
# @name Gazebo x500 swarm indoor GNSS-denied
#
# @type Quadrotor
#

PX4_SIM_MODEL=${PX4_SIM_MODEL:=x500_swarm}

. ${R}etc/init.d-posix/airframes/4001_gz_x500

echo "Configuring indoor GNSS-denied defaults for x500_swarm"
param set-default SYS_HAS_GPS 0
param set-default SIM_GPS_USED 0
param set-default EKF2_GPS_CTRL 0
param set-default COM_ARM_WO_GPS 1
# Optical flow in the default Gazebo room is fragile over low-texture surfaces and
# fights with external-vision fusion. For the SLAM/VIO indoor stack, trust EV XY/vel/yaw
# and keep the rangefinder only for height.
# Optical flow + rangefinder as EKF2's safety net (28.9.2026, owner's decision after the
# VIO runs): every sim twin flown since August (x500_d435i, hw5_d435i, hw5_d435i_sync)
# includes model://optical_flow, and SIM_GZ_EN_FLOW=1 already delivers vehicle_optical_flow
# at 50 Hz (quality 0-255, zero when the 100x100 flow camera sees nothing). With
# EKF2_OF_CTRL=0 a VIO loss dropped EKF2 to IMU-only dead reckoning; with flow and the
# downward range fused it degrades to flow odometry instead. Mirrors the hardware VIO set
# swarm_hw_bringup/px4_params/04_ekf2_vio.params (EKF2_OF_CTRL 1, EKF2_RNG_CTRL 1).
# Sensor position from the model include (FLU 0.03 0 -0.10 -> FRD 0.03 0 +0.10).
# Quality gate 1 = PX4's default, stated so the zero-quality frames are visibly dropped.
param set-default EKF2_OF_CTRL 1
param set-default EKF2_RNG_CTRL 1      # conditional range aiding (default), stated
param set-default EKF2_OF_QMIN 1
param set-default EKF2_OF_POS_X 0.03
param set-default EKF2_OF_POS_Y 0.0
param set-default EKF2_OF_POS_Z 0.10
param set-default EKF2_HGT_REF 3      # Vision (EV Z) as primary height reference
param set-default SENS_FLOW_MINHGT 0.0

# External vision (SLAM/VIO via slam_to_px4.py) feeds /fmu/in/vehicle_visual_odometry.
# EKF2_EV_CTRL=15: fuse all EV: XY+Z position, velocity, yaw.
# EKF2_MAG_TYPE=5: disable magnetometer completely — prevents heading resets on wall impact.
# EKF2_EV_NOISE_MD=0: use the per-message covariance (mocap_to_px4 / slam_to_px4
#   set it), floored by EKF2_EVP_NOISE. NOTE (fixed 20.9.2026): in PX4 v1.16
#   mode 1 means the OPPOSITE — ignore the message and use the parameter only
#   (src/modules/ekf2/EKF2.cpp ~2471). Until today this file said 1 with a 0.20 m
#   floor, so EKF2 treated the mm-accurate mocap as a 20 cm sensor and smoothed
#   away any injected pose noise. The hardware sets (03/04 params) match this now.
# EKF2_BARO_CTRL=1: the barometer stays enabled. EKF2_HGT_REF=3 keeps EV Z as the
#   height reference; the baro is fused as a secondary height source with its bias
#   estimated. (Until 27.9.2026 this comment said 0 / disabled while the line below
#   has set 1 since the file was created. The hardware sets 03/04 use 0.)
# SIM_GZ_EN_ODOM=0 (27.9.2026): PX4's own gz_bridge otherwise subscribes to the model's
#   Gazebo odometry and publishes the TRUE pose straight into vehicle_visual_odometry,
#   next to whatever mocap_to_px4 / slam_to_px4 sends. Every sim run until today fused
#   both streams (truth at 1e-4 variance beside the degraded one); the 20.9 noise sweep
#   therefore never measured what it claimed. The only EV source is now the ROS bridge.
param set-default SIM_GZ_EN_ODOM 0
param set-default EKF2_EV_CTRL 15
param set-default EKF2_EV_DELAY 50
param set-default EKF2_EVP_NOISE 0.01
param set-default EKF2_EV_NOISE_MD 0
param set-default EKF2_EVP_GATE 10
param set-default EKF2_MAG_TYPE 5
param set-default EKF2_BARO_CTRL 1
